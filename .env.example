# ==============================================================================
# ENVIRONMENT MODE
# ==============================================================================
# Options: DEV | TEST | PROD
ENVIRONMENT=DEV

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=team_project_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL
# 1. When running inside Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@db:5432/team_project_db

# 2. When running locally outside Docker (uncomment if running locally):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_project_db

# ==============================================================================
# SECURITY & JWT CONFIGURATION
# ==============================================================================
# In PROD, generate a secure 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev_secret_key_change_in_production_1234567890
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
